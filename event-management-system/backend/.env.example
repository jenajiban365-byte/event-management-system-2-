PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Get this from MongoDB Atlas: Database > Connect > Drivers > copy the connection string
# Replace <username>, <password>, and add your database name before the "?"
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/eventhub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/eventhub?retryWrites=true&w=majority
