PORT=5000
# Must be at least 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Admin account seeded only when the database has no users at all.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed once at startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Comma-separated origins allowed to call the API cross-origin.
# Leave empty when the frontend is served by this same server.
ALLOWED_ORIGINS=
EMAIL_USER=your-email@example.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_FROM=your-verified-sender@example.com
BREVO_API_KEY=your-brevo-api-key
APP_URL=http://localhost:5000
