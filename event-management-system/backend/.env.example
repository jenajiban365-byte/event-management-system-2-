PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
EMAIL_USER=your-email@example.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_FROM=your-verified-sender@example.com
BREVO_API_KEY=your-brevo-api-key
APP_URL=http://localhost:5000

# Admin bootstrap credentials (never commit real values)
ADMIN_EMAIL=admin@your-college.edu
ADMIN_PASSWORD=replace-with-a-long-random-password

# One-time destructive reset: run `RESET_USERS_CONFIRM=YES npm run reset-users` to remove all existing accounts.
# This is a command-only flag; do not keep it enabled in production.
